rules_version = '2';

// There is exactly one admin (the business owner's Firebase Auth account),
// so "signed in at all" is sufficient to mean "is the admin" — no roles needed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    // Catalog content: anyone can read, only the admin can write.
    match /company/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Single-doc catalog (pricing/main: { categories, extras }) — one write
    // replaces the whole thing, which is what lets the admin's Excel import
    // add/remove categories and extras groups, not just edit prices.
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Offer banner visibility toggle. The image itself lives in Cloudinary
    // (deterministic fixed-URL upload, unsigned preset — see lib/cloudinary
    // in the frontend); Cloudinary's actual delete API needs a secret we
    // don't have client-side, so "remove" just flips this flag instead of
    // truly deleting the asset.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leads (contact messages, pickup requests, cart orders): anyone can
    // submit one, but only the admin can read/manage the inbox. This is the
    // key property a pure "cart calculator" site doesn't need — submissions
    // must be write-only to the public, never readable by other visitors.
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customer feedback (reached via a link sent after a completed
    // service): same write-only-to-the-public shape as leads.
    match /feedback/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Incoming WhatsApp messages (number 8160677875, via Meta's Cloud API
    // webhook). Nobody creates/deletes from the client — the Cloudflare
    // Worker webhook receiver writes these using a Google Cloud service
    // account, which authenticates through Firestore's REST API with IAM
    // credentials and bypasses these rules entirely (rules only govern the
    // client SDK). The admin can read, and can only toggle `read`/`archived`.
    match /whatsappMessages/{docId} {
      allow create, delete: if false;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "archived"]);
    }

    // Daily visitor counter for the admin's Performance tab — one doc per
    // date ("YYYY-MM-DD"), `visits` only ever moves by writing
    // increment(1) from the client. The rules below are what make a public,
    // unauthenticated counter safe without a backend: a write can only ever
    // land as exactly +1 over the previous value (or 1, for a brand new
    // day), never an arbitrary number — Firestore evaluates increment()
    // before these conditions run, so request.resource.data.visits already
    // reflects the post-increment total. Only the admin can read the counts.
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(["date", "visits"])
                       && request.resource.data.visits == 1;
      allow update: if isAdmin()
                       || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visits"])
                           && request.resource.data.visits == resource.data.visits + 1);
      allow delete: if isAdmin();
    }
  }
}
